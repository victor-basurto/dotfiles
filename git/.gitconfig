# ===============================
# User identity
# ===============================
[user]
  name = "User Name"
  email = "user@email.com"

# ===============================
# Core behavior
# ===============================
[core]
  # Sets your preferred text editor for Git operations (e.g., writing commit messages).
  # Replace 'vim' with your editor of choice (e.g., 'code --wait' for VS Code, 'nano', 'subl -w', etc.)
  editor = nvim
  # When committing → Git converts CRLF → LF
  # When checking out → leaves LF untouched
  autocrlf = input
  # Leave trailing spaces
  # Put spaces before tabs
  whitespace = trailing-space,space-before-tab
  # Controls how Git displays long output.
  #
  # Flag Effect:
  # -F Quit if output fits on one screen
  # -R Preserve colors
  # -S No line wrapping (huge win)
  # -X Don’t clear screen on exit

  # - Logs readable
  # - No weird wrapping
  # - No screen flicker
  pager = less -FRSX

# ===============================
# Color UI
# ===============================
[color]
  # Enables colorful output for better readability in the terminal.
  ui = true

[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green

[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold

[color "status"]
  added = green
  changed = yellow
  untracked = red

# ===============================
# Default branch name
# ===============================
[init]
  # Sets the default branch name for newly initialized repositories (e.g., `git init`)
  # Common choices are 'main' or 'master'
  defaultBranch = main

# ===============================
# Pull / rebase behavior
# ===============================
[pull]
  # Set the default behavior for 'git pull' to rebase your local changes on top
  # of fetched changes, creating a cleaner, linear history.
  # Alternatives: 'false' for merge (default), 'ffonly' for fast-forward only.
  rebase = true

[rebase]
  # - Git auto-stashes changes
  # - Runs rebase
  # - Restores stash
  autoStash = true

# ===============================
# Push behavior
# ===============================
[push]
  # Sets the default behavior for `git push` to push only the current branch
  # to its upstream branch.
  default = simple
  # First push auto-creates upstream
  autoSetupRemote = true

# ===============================
# Branch behavior
# ===============================
[branch]
  # Sorts branches by most recently committed first when running `git branch`
  sort = -committerdate
  # When you create a branch from a remote branch:
  # Git auto-links tracking branch
  # e.g. `git switch -c feature origin/feature`
  # Git remembers relationship automatically.
  autoSetupMerge = true
  # When you pull on a branch → Git rebases instead of merges.
  # Without this → accidental merge commits.
  #
  # - Cleaner history
  # - No “Merge branch main into feature” spam
  autoSetupRebase = always

# ===============================
# Fetch behavior
# ===============================
[fetch]
  # Without this: Deleted remote branches pile up locally forever.
  # With this: Git cleans stale remote refs automatically
  #
  # Example:
  # Dev deletes branch → your repo stays clean.
  #
  # Prevents repo clutter.
  prune = true

# ===============================
# Merge defaults
# ===============================
[merge]
  # Opens Vim diff UI
  tool = vimdiff
  # With zdiff3 conflict styles:
  # 
  # Shows:
  # - Your changes
  # - Their changes
  # - Common ancestor
  conflictstyle = zdiff3

# ===============================
# Diff improvements
# ===============================
[diff]
  # Controls how Git detects changes.
  # 
  # Histogram:
  # Better at understanding moved blocks
  # Better for refactors
  # Cleaner diffs
  # 
  # Especially good for:
  # - Big files
  # - Rearranged code
  # - Styling changes
  algorithm = histogram
  # Refactors easier to review
  # Cleaner PRs
  colorMoved = default

# ===============================
# Reuse recorded conflict resolutions
# ===============================
[rerere]
  # Git remembers how you solved conflicts.
  # Next time same conflict appears:
  # Git auto-resolves it
  enabled = true

# ===============================
# Status output
# ===============================
[status]
  # All new/untracked files
  # Not just directories
  showUntrackedFiles = all

# ===============================
# Aliases (safe, portable)
# ===============================
[alias]
  #-----------------------
  # BASIC NAVIGATION
  #-----------------------
  # usage: git s feature/login
  s = switch
  # usage: git br
  br = branch
  # usage: git new feature/login
  new = switch -c

  #-----------------------
  # COMMIT HELPERS
  #-----------------------
  # usage: git cmsg "feat: add new icon"
  cmsg = commit -m
  # usage: git amend
  # use when:
  # - Forgot file
  # - Tiny code fix
  # - Formatting tweak
  amend = commit --amend --no-edit
  # usage: git amendm
  amendm = commit --amend -m

  #-----------------------
  # DAILY START UPDATE
  #-----------------------
  # Initial flow
  # devup:
  #   - fetch everything
  #   - clean deleted remove branches
  #   - rebase your current branch
  #   - auto-stash changes
  devup = !git switch develop && git fetch --all --prune && git pull

  #-----------------------
  # STATUS
  #-----------------------
  # usage: git st
  st = status
  # Smart status
  # short + branch info
  # usage: git ss
  ss = status -sb

  #-----------------------
  # PUSH
  #-----------------------
  # Safe Push
  # usage: git pushf
  pushf = "!b=$(git branch --show-current); \
    if git rev-parse --abbrev-ref --symbolic-full-name @{u} >/dev/null 2>&1; then \
      git push --force-with-lease --force-if-includes; \
    else \
      git push -u origin $b; \
    fi"

  #-----------------------
  # SYNC AND SHIP
  #-----------------------
  # Feature-branch sync alias
  # usage: git syncm
  syncm = !git fetch origin main && git rebase origin/main
  # Feature-branch sync alias work
  # usage: git sync
  sync = !git fetch origin develop && git rebase origin/develop
  # ship
  # use this command when switching to an existing branch and you want to update develop and then rebase and push force your changes
  # basically it will fetch-all and update
  ship = !git sync && git pushf;
  # is only really needed if a coworker pushed changes to your specific feature branch while you were away, and you need to grab Their
  # work before continuing yours.
  syncf = !git fetch origin $(git branch --show-current) && git rebase origin/$(git branch --show-current)
  # prevent divergence
  # usage: g up
  up = !git syncf && git sync
  # Replays your commits on top of remote commits
  # use this command before creating a PR
  # usage: g rib
  rib = "!git rebase -i origin/develop"


  #-----------------------
  # NEW GIT RELEASE FLOW
  #-----------------------
	# Fetch, then create a new branch from the latest stage (origin/release_new) with no upstream.
	# Usage: git startr feat/vb/BRL-222-change-h5-to-h4
	startr = "!f() { [ -n \"$1\" ] || { echo \"usage: git startr <type/initials/JIRA-KEY-summary>\"; return 1; }; git fetch origin && git switch -c \"$1\" --no-track origin/release_new; }; f"

	# Rebase the current branch onto the latest stage. Only before the branch's first merge into develop.
	# Usage: git syncr
	syncr = "!git fetch origin release_new && git rebase origin/release_new"

	# syncr + push (push -u the first time, --force-with-lease after that).
	# Usage: git shipr
	shipr = "!git syncr && git pushf"

	# Take a coworker's pushes to this branch first, then rebase onto the latest stage.
	# Usage: git upr
	upr = "!git syncf && git syncr"

	# Interactive rebase of your commits since stage (squash/fixup/reword before the first PR).
	# Usage: git ribr
	ribr = "!git rebase -i origin/release_new"

	# PR into develop has conflicts: create a throwaway merge/<name>-into-develop branch from develop
	# and merge the current branch into it, so conflicts are fixed there, not on your feature branch.
	# Usage (from your feature branch): git todev
	todev = "!f() { b=$(git branch --show-current); git fetch origin && git switch -c \"merge/${b##*/}-into-develop\" --no-track origin/develop && git merge --no-ff --no-edit \"$b\"; }; f"

	# Start a sprint release: create release/<version> from the latest stage.
	# Usage: git rel 4.2.0
	rel = "!f() { [ -n \"$1\" ] || { echo \"usage: git rel <x.y.z>\"; return 1; }; git fetch origin && git switch -c \"release/$1\" --no-track origin/release_new; }; f"

	# Merge QA-approved branches (from origin) into the current release branch, one by one.
	# Stops at the first conflict: fix, git add ., git commit, then rerun with the remaining branches.
	# Usage: git relmerge feat/vb/BRL-222-change-h5-to-h4 feat/sk/BRL-223-dropdown-paragraph
	relmerge = "!f() { for b in \"$@\"; do git merge --no-ff \"origin/$b\" -m \"Merge $b into $(git branch --show-current)\" || return 1; done; }; f"

	# After the release/hotfix PR is merged: update local release_new, then create and push an annotated tag v<version>.
	# Usage: git reltag 4.2.0
	reltag = "!f() { [ -n \"$1\" ] || { echo \"usage: git reltag <x.y.z>\"; return 1; }; git fetch origin && git switch release_new && git pull --ff-only origin release_new && git tag -a \"v$1\" -m \"Release $1\" && git push origin \"v$1\"; }; f"

	# List branches already merged into dev but not yet in the release (the release candidates).
	# Compares against the local release branch, else origin's copy, else stage.
	# Output is ready for relmerge. Branch names come from `git config flow.dev` / `flow.stage`
	# (defaults: develop / release_new).
	# Usage: git relpending 4.2.0   (or just: git relpending, while on a release/* branch)
	relpending = "!f() { d=$(git config --get flow.dev || echo develop); s=$(git config --get flow.stage || echo release_new); r=${1:+release/$1}; r=${r:-$(git branch --show-current)}; case \"$r\" in release/*) ;; *) echo \"usage: git relpending <x.y.z> (or run it on a release/* branch)\"; return 1;; esac; git fetch -q origin || return 1; if git rev-parse -q --verify \"refs/heads/$r\" >/dev/null; then t=$r; elif git rev-parse -q --verify \"refs/remotes/origin/$r\" >/dev/null; then t=origin/$r; else t=origin/$s; fi; git branch -r --format=\"%(refname:short)\" --merged \"origin/$d\" --no-merged \"$t\" | grep -vE \"^origin(/HEAD)?$|^origin/($d|$s|main|release/.*|merge/.*)$\" | sed \"s#^origin/##\"; }; f"
  
  #-----------------------
  # BEGIN WORK
  #-----------------------
  # Start feature
  # usage: git startm feature/new-feature
  startm = !git switch main && git pull --rebase origin main && git switch -c
  # Start feature Work
  # usage: git start feature/new-feature
  start = !git switch develop && git pull --rebase origin develop && git switch -c

  #-----------------------
  # WORK HELPERS
  #-----------------------
  # wip alias with message
  #   - `${*} - captures typing message`
  #   - `:-work in progress` - default message if none is provided
  wip = "!f() { git add -A && git commit -m \"WIP: ${*:-work in progress}\"; }; f"
  # `--keep-index`: Tells Git to leave your staged files (git add) alone.
  # `--include-untracked`: Grabs those 50 untracked files you mentioned.
  # `git stash drop`: Immediately deletes the stash it just created, effectively "cleaning" your branch to exactly what you staged.
  # Usage: git zap
  zap = !git stash push --keep-index --include-untracked && git stash drop

  #-----------------------
  # CLEANUP
  #-----------------------
  # usage: git unstage .
  unstage = restore --staged
  # usage: git wipe
  wipe = restore .

  #-----------------------
  # SAFE CLEAN
  #-----------------------
  # Preview what would be deleted (SAFE)
  # usage: git clean-preview
  clean-preview = clean -fdn
  # Delete untracked files & folders (DESTRUCTIVE)
  # usage: git clean-force
  clean-force = clean -fd

  #-----------------------
  # DIFF & LOG
  #-----------------------
  # ui
  # usage: git dw
  dw = diff
  # usage: git ds
  ds = diff --staged
  # usage: git ll
  ll = log --oneline --decorate -n 10
  # usage: git last
  last = log -1 --oneline
  # usage: git hist
  hist = log --graph --decorate --date=short \
  --pretty=format:'%C(auto)%h %C(blue)%ad %C(reset)| %C(white)%s %C(green)%d %C(dim white)[%an]'
  # usage: git lg
  lg = log --graph --decorate --oneline --all

  #-----------------------
  # DEBUG HELPERS
  #-----------------------
  # Shows the object type stored in Git.
  # usage: git type HEAD
  # usage: git type <hash>
  type = cat-file -t
  # Pretty-prints raw Git object content.
  # usage: git dump HEAD
  # usage: git dump <hash>
  dump = cat-file -p
# ===============================
# Credential handling
# ===============================
[credential]
  helper = manager
  ; helper = /usr/local/share/gcm-core/git-credential-manager

[credential "https://dev.azure.com"]
  useHttpPath = true

[credential "https://github.com"]
  useHttpPath = true

# ===============================
# Help & misc
# ===============================
[help]
    autocorrect = 20
# Override git credentials for current project
# e.g.
[includeIf "gitdir:~/projects/current-project/"]
  path = ~/.config/gitconfigs/.gitconfig.currentproject
